{
  "name": "workflow-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "contracts:sync": "tsx scripts/sync-contracts.ts",
    "contracts:check": "tsx scripts/validate-contracts.ts",
    "examples:check": "tsx scripts/validate-examples.ts",
    "lint": "eslint .",
    "release:verify-assets": "node scripts/verify-release-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test:unit && npm run test:rust",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@dagrejs/dagre": "3.0.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-log": "2.9.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xyflow/svelte": "1.6.2",
    "ajv": "8.20.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.12",
    "fast-png": "8.0.0",
    "lucide-svelte": "1.0.1",
    "marked": "18.0.7",
    "nanostores": "1.4.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.10.1",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOOP24 Workflow Studio",
  "version": "0.1.0",
  "identifier": "com.cmetech.workflowstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LOOP24 Workflow Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../contracts/**/*", "../examples/**/*", "../brands/**/*"]
  }
}
